{
  "name": "biblioteca-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run test && npm run typecheck && npm run lint && npm run build",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.15",
    "better-auth": "^1.7.15",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "mongodb": "^7.9.0",
    "mongoose": "^9.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^22.18.6",
    "oxlint": "^1.16.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.12"
  }
}
